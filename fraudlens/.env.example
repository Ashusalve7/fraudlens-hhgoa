# TigerGraph Savanna connection (database secret — never commit the real one)
TG_HOST=https://<your-workspace>.i.tgcloud.io
TG_SECRET=<your-database-secret>
TG_GRAPHNAME=FraudGraph

# Only needed when the frontend is hosted separately (Cloudflare Pages).
FRAUDLENS_ALLOWED_ORIGINS=https://<your-cloudflare-pages-domain>
